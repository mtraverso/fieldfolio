{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FieldFolio uses the camera to capture before and after photos for your jobs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FieldFolio usa la cámara para tomar fotos de antes y después de tus trabajos."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FieldFolio lets you attach existing photos to job records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FieldFolio te permite adjuntar fotos existentes a tus trabajos."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FieldFolio can lock the app with Face ID so only you can see client jobs and invoices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FieldFolio puede bloquear la app con Face ID para que solo tú veas clientes, trabajos y facturas."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FieldFolio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FieldFolio"
          }
        }
      }
    }
  },
  "version": "1.0"
}